# ── Development Dockerfile ──────────────────────────────────────────────────
# Runs the Vite dev server with hot-module replacement.
# Usage:
#   docker build -f Dockerfile.dev -t recipeapp-dev .
#   docker run -it --rm -p 5173:5173 -v "$(pwd)/src:/app/src" recipeapp-dev
# ---------------------------------------------------------------------------

FROM node:22-alpine AS dev

# Set working directory
WORKDIR /app

# Copy dependency manifests first (layer-cache friendly)
COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies)
RUN npm ci

# Copy the rest of the source
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Vite must listen on 0.0.0.0 so the port is accessible outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
