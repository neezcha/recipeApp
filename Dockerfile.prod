# ── Production Dockerfile ────────────────────────────────────────────────────
# Multi-stage build: Node 22 compiles the app, Nginx serves the static output.
# Usage:
#   docker build -f Dockerfile.prod -t recipeapp-prod .
#   docker run -d --rm -p 3002:80 recipeapp-prod
# ---------------------------------------------------------------------------

# ── Stage 1: Build ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests first (layer-cache friendly)
COPY package.json package-lock.json* ./

# Install production + dev dependencies needed for the build
RUN npm ci

# Copy source files
COPY . .

# Compile TypeScript and bundle with Vite
RUN npm run build

# ── Stage 2: Serve ──────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

# Remove the default Nginx placeholder page
RUN rm -rf /usr/share/nginx/html/*

# Copy the built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Run Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
